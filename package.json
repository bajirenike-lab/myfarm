{
  "name": "myfarm",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node -e \"const fs=require('fs'); fs.cpSync('farmer', 'dist/farmer', {recursive:true}); fs.cpSync('admin', 'dist/admin', {recursive:true});\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "expo": "~52.0.37",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.7",
    "expo-font": "~13.0.4",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.17",
    "expo-status-bar": "~2.0.1",
    "lucide-react-native": "^0.475.0",
    "query-string": "^10.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~18.3.12",
    "typescript": "^5.3.3"
  },
  "private": true
}
