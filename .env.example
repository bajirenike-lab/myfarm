# ==============================================================================
# MYFARM NIGERIA - ENVIRONMENT TEMPLATE
# ==============================================================================

EXPO_PUBLIC_APP_NAME="MyFarm"

# 1. Supabase Cloud Database & Storage
EXPO_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# 2. Termii SMS & WhatsApp Gateway (Nigerian Carrier Network)
# Get your API key at: https://dashboard.termii.com
EXPO_PUBLIC_TERMII_API_KEY="TLxxxxxxxxxxxx"
EXPO_PUBLIC_TERMII_SENDER_ID="MyFarm"
EXPO_PUBLIC_TERMII_CHANNEL="generic" # or "dnd"

# 3. Paystack Payments (NGN Debit Cards & Bank Transfers)
# Mode: "mock" (default zero-cost sandbox) or "paystack" (live/test card processing)
# Get your public key at: https://dashboard.paystack.com/#/settings/developer
EXPO_PUBLIC_PAYMENT_MODE="mock"
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
